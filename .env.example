
# Application Settings
APP_MODE=dev
APP_NAME=BulklyMail
APP_FULL_NAME=BulklyMail.com
APP_PRIMARY_LOGO_TRANSPARENT=/images/logo-primary-transparent.webp
APP_PRIMARY_LOGO_WHITE_BG=/images/logo-primary-white-bg.webp
APP_PRIMARY_LOGO_WHITE=/images/logo-primary-white.webp
APP_SOCIAL_IMAGE=/images/social-share.webp
APP_ICON=/images/favicon.webp
APP_WEBSITE=https://your-domain.com/
APP_WEBSITE_NAME=YourBrand.com

# Binance Configuration
BINANCE_API_KEY=YOUR_BINANCE_API_KEY
BINANCE_SECRET_KEY=YOUR_BINANCE_SECRET_KEY
BINANCE_WALLET_ADDRESS=YOUR_USDT_TRC20_WALLET_ADDRESS
BINANCE_QR_CODE_PATH=/images/binance-qrcode-placeholder.webp
BINANCE_ENV=test
AUTHORIZED_DOMAINS=sendgrid.com, your-domain.com, localhost

# SMTP Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=YOUR_SENDGRID_API_KEY_OR_SMTP_PASSWORD
SMTP_ENCRYPTION=TLS
SENDING_EMAIL=no-reply@your-domain.com
FROM_EMAIL=support@your-domain.com

# Developer Information
DEVELOPED_BY_COMPANY=Your Company
DEVELOPED_BY_COMPANY_URL=https://www.your-company.com/
DEVELOPER_NAME=Your Developer Name
DEVELOPER_URL=https://your-developer-portfolio.com

# Database Configuration
DB_SERVER=localhost
DB_USER=root
DB_PASS=
DB_NAME=a_bulklymail
DB_DEFAULT_SQL=default_data.sql

# Application Paths and Tables
ROOT_PATH=/a_bulklymail
TITLE_SEPERATOR= — 
CORE_TABLES=users, app_settings
SUPER_USERS=admin, softdevhassan, admin2

# Encryption Settings (Generate random 32-byte hex strings)
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here_00000000000000000000000000
ENCRYPTION_IV=your_32_char_hex_iv_here_000000000
SESSION_ENCRYPT_KEY=your_64_char_hex_session_key_here_0000000000000000000000000

# Routes Configuration
OPEN_ROUTES=/, /auth/login, /auth/signup, /auth/password-reset, /plans, /404, /setup, /api/test, /workers/email-sender, /unsubscribe, /api/check-username, /pages/privacy-policy, /pages/terms-of-service, /pages/cookie-policy, /pages/gdpr-compliance, /pages/guide, /sitemap.xml, /pages/home, /pages/features, /pages/about, /pages/contact
ROLE_ADMIN_ROUTES=/pages/dashboard, /pages/campaigns, /pages/reports, /pages/users, /pages/plans-management, /pages/usage, /pages/account, /pages/reports, /pages/queue-monitor
ROLE_USER_ROUTES=/pages/dashboard, /pages/campaigns, /pages/billing, /pages/my-plan, /pages/usage, /pages/account, /pages/reports, /pages/queue-monitor, /pages/email-groups
